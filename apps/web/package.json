    "@sentry/vite-plugin": "^11.9.0",
    "@stripe/stripe-js": "^10.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.6.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.4",
