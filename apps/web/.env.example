# Supabase — Projet : https://supabase.com/dashboard/project/jqplpnjppyyxlmessjaw
VITE_SUPABASE_URL=https://jqplpnjppyyxlmessjaw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Environnement
VITE_APP_ENV=production

# Sentry navigateur (optionnel). Désactivé si le DSN est absent.
# VITE_SENTRY_ENABLED=true
# VITE_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# VITE_SENTRY_RELEASE=cemac-integra@1.0.0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Traces plafonnées à 0.2 et replays d'erreur à 0.25; les replays de session restent à 0.
# VITE_SENTRY_REPLAY_ERROR_SAMPLE_RATE=0.25

# Source maps Sentry (build uniquement, jamais préfixer par VITE_).
# Le plugin d'upload est activé seulement si les trois valeurs sont présentes.
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=cemac-integra

# Paiements Stripe en libre-service. Fail-closed : laisser false tant que la
# migration, les Edge Functions, le webhook et tous les secrets serveur ne sont
# pas configurés et validés en mode test.
VITE_PAYMENTS_ENABLED=false

# Aucun secret, price ID ou URL de portail Stripe ne doit être préfixé VITE_.
# Les tarifs affichés viennent exclusivement du CMS; les price IDs Stripe sont
# des secrets Supabase Edge Function décrits dans supabase/SECRETS.md.
